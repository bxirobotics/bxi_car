[Unit]
Description=Arm tracking camera (headless, wait for joystick button6)
After=network.target ros_elf_launch.service

[Service]
Type=simple
User=bxi
WorkingDirectory=/home/bxi/tang/car2
ExecStart=/bin/bash /home/bxi/tang/car2/start_arm_tracking.sh --headless --joystick --tracking-mode approach --marker-ids 0 1 --print-hz 0.2
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=car2-arm-tracking

[Install]
WantedBy=multi-user.target
